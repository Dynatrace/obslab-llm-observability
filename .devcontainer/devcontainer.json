// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/kubernetes-helm
{
	"name": "Kubernetes-in-Codespaces",
	"dockerFile": "Dockerfile",
	//"name": "Kubernetes - Local Configuration",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	//"image": "mcr.microsoft.com/devcontainers/base:bullseye",

	// do not change these if you want Docker in Docker support
	"runArgs": ["--init", "--privileged", "--network=host"],
	"mounts": [ "source=/var/run/docker.sock,target=/var/run/docker-host.sock,type=bind" ],
	"overrideCommand": false,

	// some base images require a specific user name
	"remoteUser": "vscode",

	// Install extensions
	"customizations": {
		"vscode": {	
			// Set container specific settings
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh"
			},			
			"extensions": [
				"ms-azuretools.vscode-docker",
				"ms-kubernetes-tools.vscode-kubernetes-tools",
				"davidanson.vscode-markdownlint",
				"gruntfuggly.todo-tree",
				"mutantdino.resourcemonitor",
				"humao.rest-client",
				"ms-vscode.makefile-tools"
			]
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [
		30100
	],

	// add labels
	"portsAttributes": {
		"30100": { "label": "traveladvisor User Interface" }
	},

	"hostRequirements": {
		"cpus": 4
	},

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": ".devcontainer/post-create.sh",

	// Use 'postStartCommand' to run commands after the container starts.
    "postStartCommand": ".devcontainer/post-start.sh",

	// // Add recommended secrets
	"secrets": {
		"DT_ENDPOINT": {
			"description": "eg. https://abc12345.live.dynatrace.com"
		},
		"DT_TOKEN": {
			"description": "Dynatrace API token with these permissions: Ingest metrics, Ingest logs, Ingest events, Ingest OpenTelemetry, Read metrics, Write settings"
		},
		"AWS_DEFAULT_REGION": {
			"description": "AWS Region to use"
		},
		"AWS_ACCESS_KEY_ID": {
			"description": "AWS access key associated with an IAM account"
		},
		"AWS_SECRET_ACCESS_KEY": {
			"description": "AWS secret key associated with the access key"
		},
		"AWS_EMBEDDING_MODEL": {
			"description": "Bedrock embedding model to use, eg. amazon.titan-embed-text-v1"
		},
		"AWS_MODEL": {
			"description": "Bedrock AI model to use, eg. amazon.titan-text-lite-v1"
		},
		"AWS_GUARDRAIL_ID": {
			"description": "AWS Guardrail id to protect input and output prompt, eg. 5zwrmdlsra2e"
		}
	}
}
